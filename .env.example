# Copy this file to .env and fill in the values
# Never commit .env — it is gitignored

EXPO_PUBLIC_API_URL=https://budgetgarden-backend-latest.onrender.com
EXPO_PUBLIC_DOMAIN=https://getmoneygarden.com

# Google OAuth — get these from Google Cloud Console
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# RevenueCat — use test key for dev, production key via EAS Secret for builds
EXPO_PUBLIC_REVENUECAT_KEY=
